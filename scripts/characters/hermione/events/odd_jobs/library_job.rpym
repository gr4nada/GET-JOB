#     her "Thank you, [name_genie_hermione]." ("open", "base", "base", "mid") # Expression of gratitude and politeness
#     her "I always strive to do my best." ("smile", "happy", "base", "mid_soft") # Adding a detail about her motivation.
#     her "Here's the payment." ("upset", "base", "base", "mid") # Expression of calm and professionalism
#     her "As agreed, for the completion of your assigned duties." ("normal", "base", "base", "mid") # Adding context.
#     nar "You receive {number=payment} gold coins." # Narrative text for clarity
#     nar "The coins shimmer in your hand, a tangible reward for Hermione's diligent work. They are cool to the touch and reflect the ambient light with a soft, golden glow." #Adding sensorial details.
#     gen "Thank you, Hermione. Please let me know if you encounter any further... interesting occurrences during your tasks." ("base", xpos="far_left", ypos="head") # Adding a subtle hint of curiosity.
#     her "Of course, [name_genie_hermione]. I will keep you informed." ("normal", "base", "base", "mid") # Adding a response.
#     her "Have a pleasant day." ("smile", "happy", "base", "mid_soft") # Adding a polite farewell.
#     nar "Hermione gives a small, polite nod, and then turns to leave, her robes swishing softly as she walks. The faint scent of old parchment and vanilla lingers in the air after she departs." # Adding a descriptive exit.

    $ gryffindor+= 10
    $ game.gold += payment

    call her_walk(action="leave")

    $ hermione.equip(her_outfit_last)

    $ states.her.busy = True
    $ current_job = None

    jump main_room_menu

#Send Hermione to work, promoting the card game.


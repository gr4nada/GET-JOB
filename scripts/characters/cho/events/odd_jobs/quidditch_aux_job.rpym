                cho "(Maybe I should just quit... No, no. Don’t be ridiculous. I worked too hard to get here.)" ("soft", "closed", "base", "mid")  # Soft mouth, closed eyes, neutral eyebrows, pupils center (Reflection)
                cho "(Breathe in... breathe out... ignore the smug idiot next to you.)" ("soft", "closed", "base", "mid")  # Soft mouth, closed eyes, neutral eyebrows, pupils center (Reflection)
                gen "Are you meditating again?" ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center

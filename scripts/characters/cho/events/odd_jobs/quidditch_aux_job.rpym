label cho_quidditch_assistant_job:

    if not states.cho.ev.quidditch_assistant_job.intro_complete:
        $ states.cho.ev.quidditch_assistant_job.intro_complete = True
        cho "" ("base", "base", "base", "mid", xpos="right", ypos="base", trans=fade)  # Neutral, normal eyes, neutral eyebrows, pupils center
        gen "I have a job opportunity for you, Ms. Chang." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "What kind of job?" ("clench", "base", "base", "mid")  # Clenched teeth, normal eyes, neutral eyebrows, pupils center (Irritation)
        gen "The professional Quidditch team, the Rune Riders, is training at Hogwarts this season." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        gen "They need an assistant to help with training." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Wait... Are you serious?!" ("open", "base", "base", "mid")  # Open mouth, normal eyes, neutral eyebrows, pupils center (Surprise)
        gen "Yes. Their stadium has been overrun by a swarm of Ashwinders, and they need a place to train while they resolve the issue." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "This is amazing! I've always dreamed of working with a professional team!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
        gen "I thought you might say that. But before you get too excited, there are a few conditions." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Conditions? What kind of conditions?" ("clench", "base", "base", "mid")  # Clenched teeth, normal eyes, neutral eyebrows, pupils center (Irritation)
        gen "First, you’ll need to sign a confidentiality agreement. The Riders are very protective of their training methods." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "That makes sense. I can handle that." ("base", "base", "base", "mid")  # Neutral, normal eyes, neutral eyebrows, pupils center
        gen "Second, you’ll need to return any financial compensation to me." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Wait, what? Why would I have to give you the money?" ("angry", "base", "base", "mid")  # Angry mouth, normal eyes, neutral eyebrows, pupils center (Anger)
        gen "Rules are rules, Ms. Chang. Hogwarts is providing the facilities, so any compensation must be returned to the school." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "That doesn’t seem fair... I’d be doing all the work!" ("angry", "narrow", "angry", "mid")  # Anger with narrowed eyes (Angry mouth, narrowed eyes, furrowed eyebrows, pupils center)
        gen "Think of it as an investment in your future. The experience alone will be invaluable." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Hmm... I suppose you’re right. But what exactly would I have to do?" ("base", "base", "base", "mid")  # Neutral, normal eyes, neutral eyebrows, pupils center
        gen "Nothing too complicated. You’ll help with warm-ups, organize equipment, polish the brooms, and assist during practice." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Polishing brooms? That doesn’t sound very glamorous..." ("clench", "base", "base", "mid")  # Clenched teeth, normal eyes, neutral eyebrows, pupils center (Irritation)
        gen "It’s not all polishing brooms. You’ll also get to observe their training sessions up close. Imagine learning from the best players in the league!" ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "That does sound amazing... But I’m not sure if it’s worth giving up all the money." ("base", "narrow", "worried", "mid")  # Neutral worry (Neutral mouth, narrowed eyes, worried eyebrows, pupils center)
        gen "Well, there’s one more thing... Their star Seeker, Orion Knight, will be here for the training sessions." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Orion Knight?! The Orion Knight?!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
        gen "The one and only. I hear he’s quite the fan favorite." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho @ cheeks blush "He’s not just a fan favorite... He’s incredible! And so... handsome." ("soft", "base", "base", "mid")  # Soft mouth, normal eyes, neutral eyebrows, pupils center (Blushing)
        gen "So, does that change your mind?" ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Well... if it means I get to work with Orion Knight, I suppose I can overlook the money issue." ("base", "base", "base", "mid")  # Neutral, normal eyes, neutral eyebrows, pupils center
        gen "Excellent. Here’s your assistant coach uniform." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho "Uniform? What’s wrong with what I’m wearing?" ("clench", "base", "base", "mid")  # Clenched teeth, normal eyes, neutral eyebrows, pupils center (Irritation)
        gen "It’s part of the job. You’ll need to look professional while representing the team." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        cho @ cheeks blush "If it’s necessary for the job, fine. But I’m only doing this for the experience... and maybe a chance to talk to Orion." ("base", "base", "base", "mid")  # Neutral, normal eyes, neutral eyebrows, pupils center (Blushing)
        gen "Great attitude. Now go and let me know how it goes." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
        show screen blkfade
        with d5
        # Setup
        $ cho_outfit_cheerleader.used = True
        play sound "sounds/cloth_sound.ogg"
        $ cho_outfit_last.save()
        # top
        $ cho_outfit_cheerleader .group[7].color[0] ="#FFFFFFFF"  
        $ cho_outfit_cheerleader .group[7].color[1] ="#FFFFFFFF" 
        # Bottom
        $ cho_outfit_cheerleader .group[1].color[0] ="#FFFFFFFF" 
        $ cho_outfit_cheerleader .group[1].color[1] ="#FFFFFFFF" 
        # Bra
        $ cho_outfit_cheerleader .group[6].color[0] ="#FFFFFFFF"  
        # Panties
        $ cho_outfit_cheerleader .group[0].color[0] ="#FFFFFFFF"  
        # Socks 
        $ cho_outfit_cheerleader .group[5].color[0] ="#FFFFFFFF"  

        $ cho.equip(cho_outfit_cheerleader)

      
        hide screen blkfade
        with d5
        pause 2.5
        hide cho_main
        with d3
        if states.cho.level < 13:
            cho "This uniform is *amazing!* It’s so... professional!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
            gen "Professionalism, Ms. Chang. Remember, you’re representing an elite team." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "I know, I know! But it’s a bit tight... I mean, it’s *snug*! Like, really snug!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement with slight embarrassment)
            gen "Hmm... It seems a bit tight around the bottom, but oddly loose on top. Did they give you the wrong size?" ("grin", xpos="far_left", ypos="head")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Playful)
            cho "WHAT?!" ("angry", "wide", "angry", "mid")  # Angry mouth, wide eyes, furrowed eyebrows, pupils center (Shock with anger)
            gen "I’m just saying, it looks... uneven. Maybe you should ask for a different size." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "Uneven?! Are you saying my—my *top* is too loose?!" ("angry", "base", "angry", "mid")  # Angry mouth, normal eyes, furrowed eyebrows, pupils center (Intense anger)
            gen "I’m just making an observation. Professionalism, Ms. Chang. Professionalism." ("grin", xpos="far_left", ypos="head")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Playful)
            cho "I’ll show you *professionalism*! How about I *professionally* hex you into next week?!" ("angry", "base", "angry", "mid")  # Angry mouth, normal eyes, furrowed eyebrows, pupils center (Intense anger)
            gen "Now, now, Ms. Chang. Let’s not be hasty. I’m just trying to help." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "Help?! You’re not helping! You’re just—just—ugh! I can’t even look at you right now!" ("angry", "base", "angry", "mid")  # Angry mouth, normal eyes, furrowed eyebrows, pupils center (Intense anger)
            cho "(Oh no... What if he’s right? What if I’m... *gaining weight*?!)" ("soft", "narrow", "base", "downR")  # Soft mouth, narrowed eyes, neutral eyebrows, pupils down-right (Worry)
            cho "(This uniform is going to make me look ridiculous! What if Orion sees me like this?!)" ("angry", "narrow", "base", "downR")  # Angry mouth, narrowed eyes, neutral eyebrows, pupils down-right (Worry with anger)
            cho "(No, no, no! Focus, Cho! You’re here to work, not to freak out over a stupid uniform!)" ("clench", "narrow", "base", "mid")  # Clenched teeth, narrowed eyes, neutral eyebrows, pupils center (Determination)
            cho "(Breathe in... breathe out... breathe in... breathe out...)" ("soft", "closed", "base", "mid")  # Soft mouth, closed eyes, neutral eyebrows, pupils center (Calming down)
            gen "Ms. Chang? Are you... meditating?" ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "Yes, I’m meditating! Because someone decided to make me feel *completely insecure* about this uniform!" ("angry", "base", "angry", "mid")  # Angry mouth, normal eyes, furrowed eyebrows, pupils center (Intense anger)
            gen "I didn’t mean to—" ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "Don’t! Just... don’t. I’m trying to focus here." ("angry", "base", "angry", "mid")  # Angry mouth, normal eyes, furrowed eyebrows, pupils center (Intense anger)
            cho "(Alright, Cho. You’ve got this. You’re here to work, not to worry about what anyone thinks of you.)" ("base", "base", "base", "mid")  # Neutral, normal eyes, neutral eyebrows, pupils center (Calm determination)
            gen "Impressive. I didn’t know you had such self-control." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "Don’t push your luck, Gen. I’m still mad at you." ("angry", "base", "angry", "mid")  # Angry mouth, normal eyes, furrowed eyebrows, pupils center (Intense anger)
            gen "Noted. Now, let’s get to work. The Riders don’t pay for idle hands... or idle meditations." ("grin", xpos="far_left", ypos="head")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Playful)
            cho "I’m going to kill him... I’m really going to kill him..." ("angry", "narrow", "angry", "mid")  # Angry mouth, narrowed eyes, furrowed eyebrows, pupils center (Intense anger)
            gen "I heard that, Ms. Chang." ("grin", xpos="far_left", ypos="head")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Playful)
            cho "GOOD!" ("angry", "base", "angry", "mid")  # Angry mouth, normal eyes, furrowed eyebrows, pupils center (Intense anger)
            
        elif states.cho.level >= 13:
            cho "This uniform is *amazing!* It’s so... professional!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
            gen "Professionalism, Ms. Chang. Remember, you’re representing an elite team." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "I know, I know! But it’s a bit tight... I mean, it’s *snug*! Like, really snug!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement with slight embarrassment)
            cho "(Oh no... What if Orion Knight sees me like this? What if he thinks I look ridiculous?!)" ("soft", "narrow", "base", "downR")  # Soft mouth, narrowed eyes, neutral eyebrows, pupils down-right (Worry)
            cho "(I can’t let him see me struggling with this uniform... I need to look professional! But what if he offers to help? What if he touches the uniform?!)" ("angry", "narrow", "base", "downR")  # Angry mouth, narrowed eyes, neutral eyebrows, pupils down-right (Panic)
            cho "(No, no, no! Focus, Cho! You’re here to work, not to daydream about Orion Knight!)" ("clench", "narrow", "base", "mid")  # Clenched teeth, narrowed eyes, neutral eyebrows, pupils center (Determination)
            gen "Focus, Ms. Chang. You’re here to work, not to socialize." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "I *am* focused! I’m *super* focused! I mean, this is the Riders! How could I not be focused?" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
            cho "(Oh Merlin... What if I have to polish Orion’s broom? What if he’s watching me? What if he thinks I’m doing it wrong?!)" ("soft", "narrow", "base", "downR")  # Soft mouth, narrowed eyes, neutral eyebrows, pupils down-right (Worry)
            cho "(No, no, no! Stop thinking about that! It’s just a broom! It’s just a broom!)" ("angry", "narrow", "base", "mid")  # Angry mouth, narrowed eyes, neutral eyebrows, pupils center (Frustration)
            gen "Now that we’ve settled the uniform issue, let’s get to work. The Riders don’t pay for idle hands." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "They don’t pay at all, remember? But that’s fine! I’m here for the experience! And the... the *professionalism*!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
            gen "Details, Ms. Chang. Details." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "Details, schmetails! Let’s get to work! I’m ready to polish brooms, organize equipment, and... and whatever else you need!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
            cho "(What if Orion sees me polishing his broom? What if he thinks I’m doing it wrong? What if he thinks I’m... flirting with him?!)" ("soft", "narrow", "base", "downR")  # Soft mouth, narrowed eyes, neutral eyebrows, pupils down-right (Worry)
            cho "(No, no, no! Stop it, Cho! You’re here to work, not to fantasize about Orion Knight!)" ("angry", "narrow", "base", "mid")  # Angry mouth, narrowed eyes, neutral eyebrows, pupils center (Frustration)
            gen "Enough chit-chat. Let’s get to work." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center
            cho "Yes, sir! Let’s do this! I’m ready to take on the world... or at least the Riders!" ("grin", "base", "base", "mid")  # Wide smile, normal eyes, neutral eyebrows, pupils center (Excitement)
    gen "Off you go then..." ("base", xpos="far_left", ypos="head")

    call cho_walk(action="leave")

    $ states.cho.busy = True
    $ current_job = "Quidditch Assistant"

    jump main_room_menu

label cho_quidditch_assistant_job_return:

    python:
        progress_factor = math.log(states.cho.tier + states.ton.tier + states.lun.tier + game.day)
        payment = int(progress_factor * random_gold)

    $ cho_end_day = ""
    $ is_wet = False
    $ missing_top = False
    $ missing_bra = False
    $ missing_bottom = False
    $ missing_panties = False

    # Select End Day - status and Missing Clouthes
    if states.ast.level < 13:           
        random:
            block:
                # "Fire Crab Stampede"
                $ cho_end_day = "Puddle Plunge: A Quidditch Catastrophe"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = False
            block:
                # "Runaway Brooms: Cho's Cleaning Catastrophe"
                $ cho_end_day = "Runaway Brooms: Cho's Cleaning Catastrophe"
                $ is_wet = True
                $ missing_top = True
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False
            block:
                # "Freezer Fury: Cho's Drenching Disaster"
                $ cho_end_day = "Freezer Fury: Cho's Drenching Disaster"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = True
    elif states.ast.level < 22:
        random:
            block:
                $ cho_end_day = "Gravity's Betrayal: Cho's Embarrassing Broom Ride"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = False
            block:
                $ cho_end_day = "The Locker Room Shower: A Freezing Surprise"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False 
    else:
        random:
            block:
                $ cho_end_day = "Soaked and Seen: Cho's Embarrassing Broom Encounter"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False                           
            block:
                $ cho_end_day = "Team Prank Gone Wild: Cho's Flying Fiasco"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False

    call cho_walk(action="enter", xpos="mid", ypos="base")
    
    if is_wet:
        # top
        $ cho_outfit_cheerleader.group[7].color[0] ="#DDDDDDDD"  
        $ cho_outfit_cheerleader.group[7].color[1] ="#DDDDDDDD" 
        #bottom
        $ cho_outfit_cheerleader.group[1].color[0] ="#DDDDDDDD" 
        $ cho_outfit_cheerleader.group[1].color[1] ="#DDDDDDDD" 
        #Bra
        $ cho_outfit_cheerleader.group[6].color[0] ="#DDDDDD33"  
        # panties
        $ cho_outfit_cheerleader.group[0].color[0] ="#DDDDDDAA"   
        # socks 
        $ cho_outfit_cheerleader.group[5].color[0] ="#AAAAAACC"  

    $ cho.equip(cho_outfit_cheerleader)
        
    if missing_top:
        $ cho.strip("top")
    if missing_bra:
        $ cho.strip("bra")
    if missing_bottom:
        $ cho.strip("bottom")
    if missing_panties:
        $ cho.strip("panties")

    gen "Ms. Chang... How was your first day as an assistant coach?" ("grin", xpos="far_left", ypos="head")
    cho "Well... It was *definitely* an experience..." ("annoyed", "base", "base", "mid", xpos="right", ypos="base")

    menu:
        "What happened?":
            if cho_end_day== "Puddle Plunge: A Quidditch Catastrophe":
                # "Puddle Plunge: A Quidditch Catastrophe"

            elif cho_end_day=="Freezer Fury: Cho's Drenching Disaster":
                # "Freezer Fury: Cho's Drenching Disaster"
                cho "I can’t believe I fell asleep on the coach’s bench... I just wanted a quick nap..." ("soft", "narrow", "worried", "mid")  # Soft mouth, narrowed eyes, worried eyebrows, pupils center (Worry)
                gen "You’ve been working hard. No one will blame you for resting a little." ("base", xpos="far_left", ypos="head")  # Neutral, normal eyes, neutral eyebrows, pupils center

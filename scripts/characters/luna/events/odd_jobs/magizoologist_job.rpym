label lun_magizoologist_job:
    # Intro
    if not states.lun.ev.magizoologist.intro_complete:
        $ states.lun.ev.magizoologist.intro_complete = True
        lun "" ("base", "base", "base", "mid", xpos="right", ypos="base", trans=fade)  
        gen "I have a job opportunity for you, [name_luna_genie]." ("base", xpos="far_left", ypos="head")  
        lun "What kind of job?" ("soft", "base", "raised", "mid")  # Curious  
        gen "You have three options, all involving magical creatures and plants." ("base", xpos="far_left", ypos="head")  
        gen "You can help take care of fantastic creatures at the Magical Menagerie, deal with Devil’s Snare and Venomous Tentacula in the Hogwarts greenhouse, or clean the Black Lake."  ("base", xpos="far_left", ypos="head")  
        lun "Ah... well, I love animals and plants...{heart} I feel connected to them, but..." ("soft", "base", "base", "mid")  # Serene  
        lun "You know... just thinking about working makes me feel so lazy..." ("soft", "narrow", "base", "mid")  # Reflective  
        gen "But, Luna, think about it... not only is it a unique opportunity, but you'll be rewarded... and you could even... well, let's say, do a good deed with that money." ("base", xpos="far_left", ypos="head")    
        lun "Rewarded? What do you mean by that?" ("soft", "base", "base", "up")  # Curious  
        gen "Ah, the money... you could donate it to a good cause, like an organization that helps animals, for example."  ("base", xpos="far_left", ypos="head")  
        lun "Donate? Hmm..." ("base", "narrow", "base", "mid")  # Perplexed  
        lun "That sounds... a little too convenient." ("annoyed", "base", "raised", "mid")  # Skeptical  
        gen "And, of course, I'd be more than happy to help with that. What's important is helping, right?"   ("grin", xpos="far_left", ypos="head")
        gen "I... I wouldn't keep anything, of course. Ah... you'll feel really good doing something so noble."  ("base", xpos="far_left", ypos="head")  
        lun "...I don't know." ("base", "narrow", "base", "mid")  # Perplexed  
        lun "I just get the feeling you're hiding something..." ("normal", "base", "annoyed", "mid")  # Suspicious  
        lun "Hmm..." ("soft", "closed", "base", "mid")  # Shy  
        lun "Are you sure there's no catch here? No... trick or secret plan you're not telling me about?" ("annoyed", "base", "raised", "mid")  # Skeptical  
        gen "...Nope."  ("base", xpos="far_left", ypos="head") 
        lun "You're not even going to try to explain it, are you?" ("base", "narrow", "base", "mid")  # Perplexed  
        gen "...Nope."  ("angry", xpos="far_left", ypos="head") 
        lun "...You know, I'm getting the feeling that you're just not very good at this convincing thing." ("grin", "narrow", "base", "mid")  # Cheerful  
        gen "It's not about convincing, Luna. It's about... letting you make your own choice."  ("base", xpos="far_left", ypos="head") 
        lun "Hmm..." ("soft", "closed", "base", "mid")  # Shy  
        lun "Wait a second..." ("grin", "base", "base", "mid")  # Happy  
        lun "I just remembered something! I read my horoscope today, and it said I would have an unexpected opportunity to work with something I love!" ("grin", "base", "base", "mid")  # Happy  
        lun "It even said that helping others with my passion would bring me joy. But here's the interesting part..." ("soft", "base", "base", "stare")  # Intrigued  
        lun "It also said I shouldn't get attached to material things... that I should focus on what truly matters, and that I'll be rewarded for it later." ("soft", "closed", "base", "mid")  # Shy  
        lun "This... this is it! Working with magical creatures and plants, and not worrying about the money... it’s exactly what I needed!" ("grin", "base", "base", "mid")  # Happy  
        lun "So, yeah, I’m in! I’ll do it!" ("grin", "closed", "base", "mid")  # Satisfied  
        gen "Well... I guess that worked out nicely, huh?"  ("base", xpos="far_left", ypos="head") 
        lun "It’s fate, I suppose! And I’ll donate the money, just like my horoscope told me to!" ("grin", "wink", "base", "mid")  # Playful  
        gen "Uh... sure, Luna. That’s the spirit."  ("base", xpos="far_left", ypos="head") 
        lun "Oh, well..." ("base", "narrow", "base", "mid")  # Perplexed 
    else:
        lun "" ("base", "base", "base", "mid", xpos="right", ypos="base", trans=fade)  
        gen "I have another job opportunity for you, [name_luna_genie]." ("base", xpos="far_left", ypos="head")  
        lun "What kind of job this time?" ("soft", "base", "raised", "mid")  # Curious  
        gen "You have the same three choices, all related to magical creatures and plants."  ("grin", xpos="far_left", ypos="head")  
        gen "You can help take care of fantastic creatures at the Magical Menagerie, deal with Devil’s Snare and Venomous Tentacula in the Hogwarts greenhouse, or clean the Black Lake." ("base", xpos="far_left", ypos="head")  
        lun "Oh, well..." ("soft", "narrow", "base", "mid")  # Shy  
    # Dream
    menu:
        "-Ask what she has to say-":
            if states.lun.level < 4:
                random:
                    block:
                        gen "Would you like to tell me what’s on your mind?" ("base", xpos="far_left", ypos="head")
                        lun "I had the most peculiar dream last night… I was floating in a pool of warm, shimmering water." ("soft", "base", "base", "mid")  # Sonhadora
                        gen "That sounds rather nice. Was anyone else there?" ("base", xpos="far_left", ypos="head")
                        lun "No one I could see. But the water itself… it moved around me, like it was alive, caressing my skin, tracing patterns over me with the gentlest pressure." ("open", "base", "base", "mid")  # Imaginando a sensação
                        gen "That’s… strangely intimate." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Mmm… It was. Every ripple sent little shivers through me. It felt as if the air itself was vibrating, humming against my skin, like a whispered secret I couldn’t quite understand." ("soft", "narrow", "base", "close")  # Reflexiva e imersa na lembrança
                        gen "And then?" ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "I don’t remember waking up… Just the sensation lingering, wrapping around me like an invisible embrace." ("soft", "narrow", "base", "mid")  # Ainda sentindo a experiência
                    block:
                        gen "I’m curious to know what you're thinking."("base", xpos="far_left", ypos="head")
                        lun "I had a dream about a rabbit last night." ("soft", "base", "base", "mid")  # Reflexiva
                        gen "A rabbit? What about it?" ("base", xpos="far_left", ypos="head")
                        lun "It wanted to be eaten... but no one wanted to eat it. Poor thing." ("open", "base", "base", "mid")  # Confusa com o significado
                        gen "Well, I like eating rabbits. I could've helped." ("base", xpos="far_left", ypos="head")
                        lun "That would’ve made him happy, I think. But alas, the dream ended before he found his purpose." ("soft", "base", "base", "mid")  # Filosófica sobre o destino do coelho
                    block:
                        gen "What’s going through your head right now?" ("base", xpos="far_left", ypos="head")
                        lun "I dreamt I was in the Great Hall, but it wasn’t quite right. The ceiling stretched endlessly, and there were golden staircases leading to nowhere." ("soft", "base", "base", "mid")  # Pensativa
                        gen "Hogwarts does like to change things up." ("base", xpos="far_left", ypos="head")
                        lun "There was a table filled with the most delicious things… Strawberries so ripe they nearly burst, dark chocolate melting at the slightest touch, and goblets of the richest red wine." ("open", "base", "base", "mid")  # Imaginando os sabores
                        gen "And let me guess… You indulged?" ("base", xpos="far_left", ypos="head")
                        lun "Oh, yes… Each bite was slow, decadent. The taste of berries sweet and tart on my tongue, my lips sticky with nectar. And the wine… it left my head light, my limbs heavy, as if I were sinking into something… deep." ("soft", "narrow", "base", "close")  # Envolvida pela lembrança sensorial
                        gen "Sounds like a rather intoxicating dream." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Mmm… It was. And then, just as I reached for another taste… the dream faded. Such a shame." ("soft", "narrow", "base", "mid")  # Lamentando o fim do sonho
                    block:
                        gen "Care to share what you're thinking?" ("base", xpos="far_left", ypos="head")
                        lun "I had a dream about my Defense Against the Dark Arts professor last night." ("soft", "base", "base", "mid")  # Reflexiva
                        gen "Were they teaching you how to duel?" ("base", xpos="far_left", ypos="head")
                        lun "Yes… but every time I failed to block a spell, they flicked their wand, making me stumble." ("open", "base", "base", "mid")  # Narrando a experiência
                        lun @ cheeks blush "And since I was wearing a short skirt, well… it made things even more embarrassing." ("soft", "narrow", "base", "mid")  # Levemente envergonhada
                        gen "That sounds like a harsh lesson." ("base", xpos="far_left", ypos="head")
                        lun "It was… But I could tell they were enjoying watching me try to regain my balance." ("soft", "base", "base", "mid")  # Perceptiva sobre a situação
                        lun @ cheeks blush "By the end, I was failing on purpose, just to see how they'd react." ("soft", "narrow", "base", "close")  # Brincando com a situação
                    block:
                        lun "I had a dream about a dragon last night." ("soft", "base", "base", "mid")  # Reflexiva
                        gen "A fire-breathing, treasure-hoarding dragon?" ("base", xpos="far_left", ypos="head")
                        lun "Yes, but he wasn’t aggressive. He was massive, and his body was so warm..." ("open", "base", "base", "mid")  # Fascinada pela criatura
                        gen "You weren’t scared?" ("base", xpos="far_left", ypos="head")
                        lun "Not at all. I rested against his chest, feeling the rumble of his breath... like a soothing lullaby." ("soft", "narrow", "base", "mid")  # Se sentindo segura
                        lun @ cheeks blush "I never wanted to wake up." ("soft", "narrow", "base", "close")  # Nostálgica pelo sonho
            if states.lun.level < 13:
                random:
                    block:
                        gen "So, what’s on your mind?"("base", xpos="far_left", ypos="head")
                        lun "I had the most peculiar dream… I wasn’t quite myself." ("base", "closed", "base", "mid") # Neutral, but slightly reserved.
                        gen "What do you mean?" ("base", xpos="far_left", ypos="head")
                        lun "My body… it shifted. I was weightless one moment, then sinking the next. My skin tingled, as if it was waking up to something new, something more." ("soft", "base", "base", "up") # Curious, intrigued by the sensation.
                        gen "That sounds… intense." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Mmm… It was. I felt strong and vulnerable all at once. Like I was being guided, but also leading. Each sensation built upon the last, threading through me like an unspoken command." ("soft", "narrow", "base", "downR") # Normal Embarrassed, due to the intimate nature of the dream.
                        gen "And when you woke up?" ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "The feeling lingered. Power and surrender… like two halves of the same dream, still echoing inside me." ("soft", "narrow", "base", "downR") # Normal Embarrassed, still flustered.
                        gen "That’s... quite the dream. But why do you look so flustered?" ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Well… I also woke up completely soaked." ("angry", "base", "base", "downR") # Embarrassed, due to the explanation.
                        gen "Wait… soaked? Like…?" ("base", xpos="far_left", ypos="head")
                        lun "Oh, yes. Absolutely drenched. My bed, my hair, even my pajamas… It turns out, I fell asleep with my window open, and it rained right through the night!" ("smile", "base", "base", "mid") # Happy, relieved to clarify.
                        gen "Luna, you had me worried for a second!" ("grin", xpos="far_left", ypos="head")
                        lun "Dreams are funny like that, aren’t they? Sometimes they leave you with more than just memories." ("soft", "base", "base", "mid") # Curious, pondering the nature of dreams.
                    block:
                        gen "Care to share what you're thinking?"("base", xpos="far_left", ypos="head")
                        lun "I wandered into a garden last night… but not like any I’ve ever seen before." ("base", "closed", "base", "mid") # Neutral, but slightly reserved.
                        gen "A magical one?" ("base", xpos="far_left", ypos="head")
                        lun "More than that. The flowers pulsed with light, petals opening and closing like they were breathing. The air smelled of honey and something… forbidden." ("soft", "base", "base", "up") # Curious, intrigue from the sensory details.
                        gen "Forbidden? That’s an interesting way to describe it." ("base", xpos="far_left", ypos="head")
                        lun "Mmm… It was thick, heavy… like velvet wrapping around me. I could feel the ground beneath my bare feet, warm and soft, and when the wind passed through the trees, it whispered my name." ("soft", "narrow", "base", "downR") # Normal Embarrassed, again due to the intimate nature of the dream.
                        gen "That sounds... strangely intimate." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "It was. And just as I reached the heart of the garden… something unseen brushed against me, trailing along my skin like the lightest of fingertips." ("soft", "narrow", "base", "downR") # Normal Embarrassed, still flustered.
                        gen  "(suddenly stroking an imaginary beard) Ah, yes… That does sound quite magical. Or perhaps… you just sleepwalked into Professor Sprout’s greenhouse again?"("base", xpos="far_left", ypos="head")
                        lun  "Oh no… Do you think I accidentally confessed my secrets to a particularly wise Mandrake?"("base", "closed", "base", "mid") # Neutral, pondering the possibility.
                        gen  "If so, let’s hope it doesn’t scream them out in class tomorrow." ("base", xpos="far_left", ypos="head")
                        lun  "Well, that would certainly make Herbology more interesting!"("smile", "base", "base", "mid") # Happy, finding the humor in the situation.
            if states.lun.level < 22:
                random:
                    block:
                        gen "Would you like to tell me what’s on your mind?" ("base", xpos="far_left", ypos="head")
                        lun "There was someone in my dream last night. Or… something." ("base", "closed", "base", "mid") # Neutral, slightly reserved.
                        gen "That’s ominous." ("base", xpos="far_left", ypos="head")
                        lun "Not at all. They didn’t have a face, but I knew them. Their presence was warm… familiar. When they moved, they weren’t quite solid, shifting between shapes, between energies." ("soft", "base", "base", "up") # Curious, intrigued by the description.
                        gen "Like… a ghost?" ("base", xpos="far_left", ypos="head")
                        lun "No… more like a dream given form. They circled around me, close enough that I could feel them, but never quite touching. And yet… I shivered, as if they had." ("soft", "narrow", "base", "downR") # Normal Embarrassed, due to the intimate description of the dream.
                        gen "That’s… oddly intimate." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Mmm… It was. They never spoke, but I felt them… inside my thoughts, inside my breath. Like a secret only I was meant to hear." ("soft", "narrow", "base", "downR") # Normal Embarrassed, still flustered by the intimate nature.
                        gen "That sounds... intense. And a little bit eerie." ("base", xpos="far_left", ypos="head")
                        lun "Mmm... maybe. But it was also quite nice. Like being wrapped in moonlight." ("soft", "base", "base", "mid") # Curious, contemplative.
                        gen "And then you woke up?" ("base", xpos="far_left", ypos="head")
                        lun "Yes... soaked." ("base", "closed", "base", "mid") # Neutral, slightly reserved.
                        gen "Wait, what?!" ("open", "wide", "raised", "mid") # Surprised, due to the unexpected detail.
                        lun @ cheeks blush "Mmm… I think it must have been the Nargles. They do love playing tricks with water." ("soft", "narrow", "base", "downR") # Normal Embarrassed, using a whimsical excuse.
                        gen "Right. Of course. Nargles." ("base", xpos="far_left", ypos="head")
                    block:
                        gen "So, what’s on your mind?"("base", xpos="far_left", ypos="head")
                        lun "I had a dream about a giant octopus last night." ("base", "closed", "base", "mid") # Neutral, slightly reserved.
                        gen "Oh no... Let me guess, it grabbed you?" ("base", xpos="far_left", ypos="head")
                        lun "Yes… So many tentacles… They moved so fluidly, coiling around me, each touch cool and deliberate." ("soft", "base", "base", "up") # Curious, intrigued by the dream's details.
                        gen "And you weren’t terrified?" ("base", xpos="far_left", ypos="head")
                        lun "I thought I would be… but the way it held me—firm, yet careful—was oddly mesmerizing." ("soft", "base", "base", "mid") # Curious, contemplative.
                        lun @ cheeks blush "Every touch sent a shiver down my spine… It felt like being part of something vast, something beyond myself." ("soft", "narrow", "base", "downR") # Normal Embarrassed, flustered by the intimate description.
                        gen "That’s… quite the dream." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Mmm... Even after I woke up… that pulsing sensation remained, lingering deep inside me for a long time" ("soft", "narrow", "base", "downR") # Normal Embarrassed, still flustered by the lingering sensation.
            else :
                random:
                    block:
                        lun "I had a dream about my Transfiguration professor last night."("base", "closed", "base", "mid") # Neutral, slightly reserved.
                        gen "Did they turn you into something strange?"("base", xpos="far_left", ypos="head")
                        lun "Not exactly… They told me to transform objects, but every time I got distracted, they’d tap their wand on my hand."("soft", "base", "base", "up") # Curious, intrigued by the dream's details.
                        gen "Strict, aren’t they?"("base", xpos="far_left", ypos="head")
                        lun "The taps weren’t painful… just sharp enough to remind me to focus."("base", "closed", "base", "mid") # Neutral, slightly reserved.
                        lun "I started making tiny mistakes on purpose, just to feel it again."("soft", "narrow", "base", "downR") # Normal Embarrassed, due to the revealing nature of the dream.
                        gen "You really wanted that attention, huh?"("base", xpos="far_left", ypos="head")
                        lun "I guess I did. It was... kind of addictive? In a weird way."("soft", "base", "base", "mid") # Curious, contemplative.
                        gen "Wow, so now you’re into pain... but magical pain."("base", xpos="far_left", ypos="head")
                        lun "No! No, it wasn’t like that! It was more like… a reminder that I had to stay focused."("base", "closed", "base", "mid") # Neutral, defensive.
                        lun "But maybe it was kind of nice… the way it felt when I got distracted and they’d tap my hand, like… a little shock to the system."("soft", "narrow", "base", "downR") # Normal Embarrassed, revealing more than intended.
                        gen "I’m pretty sure that’s not what Transfiguration class is supposed to be about..."("base", xpos="far_left", ypos="head")
                        lun "I mean… it was just a dream! Just a dream!"("base", "closed", "base", "mid") # Neutral, defensive.
                        gen "So, do you wake up wanting more 'taps' now?"("base", xpos="far_left", ypos="head")
                        lun "Ugh! No!" ("angry", "closed", "base", "mid") # Annoyed, defensive.
                    block:
                        lun "I had a dream about a dragon last night." ("base", "closed", "base", "mid") # Neutral, slightly reserved.
                        gen "A fire-breathing, treasure-hoarding dragon?" ("base", xpos="far_left", ypos="head")
                        lun "Yes, but he wasn’t aggressive. He was massive, and his body was so warm..." ("soft", "base", "base", "up") # Curious, intrigued by the dream.
                        gen "You weren’t scared?" ("base", xpos="far_left", ypos="head")
                        lun "Not at all. I rested against his chest, feeling the rumble of his breath... like a soothing lullaby." ("soft", "base", "base", "mid") # Curious, contemplative.
                        lun @ cheeks blush "I never wanted to wake up." ("soft", "narrow", "base", "downR") # Normal Embarrassed, due to the intimate description.
                        gen "I bet you didn't want to wake up... or maybe it was just the warmth that kept you there." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Maybe... but it wasn’t just the warmth. It was... something else. Something more." ("soft", "narrow", "base", "downR") # Normal Embarrassed, still flustered.
                        gen "Oh? And what would that be?" ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Let’s just say... when I woke up, I felt a little too warm." ("soft", "narrow", "base", "downR") # Normal Embarrassed, implying something more.
                        gen "Is that so? Well, maybe I should stay close... help you cool off." ("base", xpos="far_left", ypos="head")
                        lun @ cheeks blush "Maybe... but only if you think you can handle it." ("soft", "narrow", "base", "downR") # Normal Embarrassed, playfully suggesting something.
        "-I don't want to hear it-":
            random:
                block: 
                    gen   "Ah, [name_luna_genie], as much as I value your unique perspective, I'm afraid I must decline this time."("base", xpos="far_left", ypos="head")
                block: 
                    gen   "I do believe your thoughts are intriguing, but at the moment, my duties require my full attention."("base", xpos="far_left", ypos="head")
                block: 
                    gen   "[name_luna_genie], I regret to say that the matters at hand leave me with little time for further discussion."("base", xpos="far_left", ypos="head")
                block: 
                    gen   "Your ideas are always fascinating, but I must kindly ask for your understanding, as I am pressed for time."("base", xpos="far_left", ypos="head")
                block: 
                    gen   "While your curiosity is always appreciated, I fear I must attend to other matters now, [name_luna_genie]."("base", xpos="far_left", ypos="head")

    gen "... Right. So, which job do you want to take?" ("base", xpos="far_left", ypos="head")
    lun "I suppose the winds of fate will choose for me." ("base", "base", "base", "close")
    play sound "sounds/thunder.ogg"
    lun @ cheeks blush "Let me think..." ("base", "narrow", "base", "close") # Normal Embarrassed, flustered by the sudden thunder.

    $ luna_random_choice = renpy.random.choice(["Magical Menagerie", "Magical Plants", "Black Lake"])

    if luna_random_choice == "Magical Menagerie":
        lun "Magical Menagerie? Hmm... I don’t think that’s a good idea." ("base", "narrow", "base", "mid") # Thoughtful, expressing concern.
        lun "My Pisces horoscope says today is a bad day for dealing with fiery creatures. Something about the moon being too close to Mars." ("base", "closed", "base", "mid") # Neutral, stating her reason.
        gen "Oh please, you don’t actually believe that, do you?" ("base", xpos="far_left", ypos="head")
        lun "The universe speaks in mysterious ways, [name_luna_genie]." ("annoyed", "base", "base", "mid") # Annoyed, defending her belief.

    elif luna_random_choice == "Magical Plants":
        lun "Oh dear... Working with magical plants today?" ("base", "narrow", "base", "mid") # Thoughtful, expressing concern.
        lun "My horoscope says that plants will be unusually aggressive under Neptune's influence." ("base", "closed", "base", "mid") # Neutral, stating her reason.
        gen "That sounds like nonsense." ("base", xpos="far_left", ypos="head")
        lun "Maybe... But have you ever seen an angry Tentacula? It’s terrifying." ("base", "closed", "base", "mid") # Neutral, providing a cautionary example.

    else:  # Black Lake
        lun "The Black Lake? I see... That’s the worst one!" ("angry", "narrow", "worried", "mid") # Worried, expressing strong disapproval.
        gen "Why’s that?" ("base", xpos="far_left", ypos="head")
        lun "Because my horoscope says that water is especially treacherous under today’s celestial alignment!" ("angry", "closed", "base", "mid") # Angry, stating her reason with emphasis.
        lun "What if the Grindylows are in a bad mood? Or the giant squid is feeling playful?" ("angry", "base", "angry", "mid") # Angry, expressing specific fears.
        gen "I’m sure you’ll manage. Just be cautious and don’t provoke any underwater creatures." ("base", xpos="far_left", ypos="head")
        gen "Why’s that?" ("base", xpos="far_left", ypos="head")

    gen "Well, I’ve made my decision. " ("base", xpos="far_left", ypos="head")
    lun "*Sigh*..." ("base", "closed", "base", "mid") # Neutral, expressing resignation.

    menu:
        "Take care of fantastic creatures at the Magical Menagerie.":
            $ luna_current_job = "Magical Menagerie"
            lun "Magical Menagerie?" ("base", "closed", "base", "mid") # Neutral, slightly reserved, questioning the choice.
            lun "I don’t think that’s a good idea." ("base", "narrow", "base", "mid") # Thoughtful, expressing concern.
            gen "Why not?" ("base", xpos="far_left", ypos="head")
            lun "Because my Aquarius horoscope says today is an unlucky day for dealing with fiery creatures." ("base", "closed", "base", "mid") # Neutral, stating her reason.
            gen "[name_luna_genie], you don’t believe in that nonsense, do you?" ("base", xpos="far_left", ypos="head")
            lun "The stars don’t lie, [name_luna_genie]. But... I suppose I can be careful." ("soft", "base", "base", "mid") # Curious, contemplative, with slight resignation.
            gen "Great! Here’s your proper uniform for the task." ("base", xpos="far_left", ypos="head")

        "Work with Devil’s Snare and Venomous Tentacula in the Hogwarts greenhouse.":
            $ luna_current_job = "Magical Plants"
            lun "Oh dear..." ("base", "narrow", "base", "mid") # Thoughtful, expressing concern.
            lun "The horoscope also says plants are feeling aggressive today." ("base", "closed", "base", "mid") # Neutral, stating her reason.
            gen "That sounds made up." ("base", xpos="far_left", ypos="head")
            lun "Maybe. But have you ever seen an angry Tentacula? It’s terrifying." ("base", "closed", "base", "mid") # Neutral, providing a cautionary example.
            gen "I’m sure you’ll manage. Here’s your special uniform for the job." ("base", xpos="far_left", ypos="head")

        "Clean the Black Lake.":
            $ luna_current_job = "Black Lake"
            lun "The Black Lake? Do I have to?" ("base", "narrow", "base", "mid") # Thoughtful, expressing reluctance.
            gen "Yes, it needs cleaning. What’s wrong?" ("base", xpos="far_left", ypos="head")
            lun "Because you picked a swimsuit that barely covers anything!" ("angry", "closed", "base", "mid") # Angry, expressing strong disapproval.
            lun "The mermaids will never stop laughing at me!" ("angry", "base", "angry", "mid") # Angry, expressing specific fear.
            gen "It’s proper lake-cleaning attire, [name_luna_genie]. You’ll be fine." ("base", xpos="far_left", ypos="head")
            lun "It’s practically a bikini! And it’s so small...!" ("angry", "closed", "base", "mid") # Angry, reiterating her disapproval.
            gen "You’ll be fine. Just get the job done quickly." ("base", xpos="far_left", ypos="head")
            lun "*Sigh*... I suppose there’s no way out of this..." ("base", "closed", "base", "mid") # Neutral, expressing resignation.

    gen "Come back in the evening to report how it went and turn in any payments." ("base", xpos="far_left", ypos="head")
    lun "..." ("angry", "narrow", "worried", "mid") # Worried, expressing silent disapproval.
    gen " (luna... I don’t know why, but something tells me it’s never wise to upset you.)" ("base", xpos="far_left", ypos="head")
    gen " (Ancient spirits of nature have a way of remembering those who cross their chosen ones...)" ("base", xpos="far_left", ypos="head")
    show screen blkfade
    with d5
    # Setup
    $ lun_outfit_magizoologist.used = True
    play sound "sounds/cloth_sound.ogg"
    $ lun_outfit_last.save()
    # Equip outfit
    if luna_current_job == "Black Lake":
        $ luna.equip(lun_outfit_bikini3)
    elif luna_current_job == "Magical Menagerie":
        $ luna.equip(lun_outfit_default)
    else:
        $ luna.equip(lun_outfit_default)     

    hide screen blkfade
    with d5

    pause 2.5
    hide lun_main
    with d3

    gen "Off you go, then..." ("base", xpos="far_left", ypos="head")

    call lun_walk(action="leave")
    $ states.lun.busy = True
    jump main_room_menu

label lun_magizoologist_job_return:
    
    python:
        progress_factor = math.log(states.lun.tier + states.cho.tier + states.ton.tier + states.lun.tier + game.day)
        payment = int(progress_factor * random_gold)


    $ dialogue_label = "Fire Crab Stampede"
    $ is_wet = False
    $ missing_top = False
    $ missing_bra = False
    $ missing_bottom = False
    $ missing_panties = False

    if luna_current_job == "Magical Menagerie":

        # dialogue_label and appearance config
        if states.lun.level < 4:
            random:
                block:
                    # "Fire Crab Stampede"

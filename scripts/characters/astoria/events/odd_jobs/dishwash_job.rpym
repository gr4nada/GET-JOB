# Library Job  
label ast_dishwasher_job:  

    if not states.ast.ev.dishwasher_job.intro_complete:  
        $ states.ast.ev.dishwasher_job.intro_complete = True  

        ast "" ("base", "base", "base", "mid", xpos="right", ypos="base", trans=fade)
        gen "I have anotast job opportunity for you, [name_astoria_genie]." ("base", xpos="far_left", ypos="head")
        ast "What kind of job this time?"("clench", "base", "base", "mid")
        gen "Tom, the owner of the Leaky Cauldron, needs an extra hand washing dishes." ("base", xpos="far_left", ypos="head")
        ast "You want me to scrub dishes in a hot, steamy kitchen?" ("angry", "base", "angry", "mid")
        gen "That’s exactly it! A good, honest job. And of course, you'll be rewarded with house points." ("base", xpos="far_left", ypos="head")

        if states.ast.level < 4:
            ast "I suppose it could be worse..." ("base", "closed", "base", "mid")
            ast "Alright, I’ll do it!" ("base", "base", "base", "mid")
            gen "Great! Here’s your uniform." ("base", xpos="far_left", ypos="head")
            ast "..." ("angry", "narrow", "base", "down")
            ast "You have got to be kidding me!" ("clench", "squint", "base", "down")
            gen "What’s the problem?" ("base", xpos="far_left", ypos="head")
            ast "This apron is so short it barely covers anything!" ("disgust", "squint", "base", "mid")
            ast "And why does this top have such a deep neckline?! This isn't necessary for washing dishes!" ("angry", "base", "angry", "mid")
            gen "Standard uniform. Rules are rules, [name_astoria_genie]." ("base", xpos="far_left", ypos="head")
            ast "And this fabric... It's white! If it gets wet, it'll be *completely* see-through!" ("angry", "narrow", "worried", "mid")
            gen "I suppose you’ll just have to be extra careful, then." ("base", xpos="far_left", ypos="head")
            ast "*Sigh*... Fine, let's get this over with." ("angry", "closed", "angry", "mid")
            gen "Good attitude! Now, get to work and come back when you're done." ("base", xpos="far_left", ypos="head")

            hide astoria_main
            with d3

            call tutorial("points")

            $ _event.cancel()
            jump astoria_favor_menu.odd_jobs
                
        elif states.ast.level < 13:
            ast "You called for me, [name_genie_astoria]?" ("angry", "base", "base", "mid")
            gen "Yes, I have something for you to wear..." ("base", xpos="far_left", ypos="head")
            ast @ cheeks blush "A librarian’s outfit?! This is completely inappropriate!" ("angry", "narrow", "base", "down")
            gen "You need to be properly dressed for the job, don’t you think?" ("base", xpos="far_left", ypos="head")  
            gen "You'll be compensated with points, naturally." ("base", xpos="far_left", ypos="head")
            ast "*Hmm*...{w=0.4} Well, if it contributes to knowledge and order, I suppose I can accept." ("angry", "closed", "base", "mid")
            gen "Good. However, any monetary compensation must be returned to me." ("base", xpos="far_left", ypos="head")
            ast "Must I?" ("clench", "base", "base", "mid")
            gen "Do you think I can just let students profit from these tasks?" ("base", xpos="far_left", ypos="head")
            ast "*Ehm*..." ("angry", "base", "base", "mid")
            gen "No, I believe it’s best if I handle that for now." ("base", xpos="far_left", ypos="head")
            ast "Very well..." ("open", "base", "base", "mid")
            gen "Return in the evening to report how it went and turn in any payments." ("base", xpos="far_left", ypos="head")

            if not is_in_lead(gryffindor):
                ast "Alright..." ("open", "squint", "base", "R")
                ast "Let me just get changed..." ("angry", "squint", "base", "mid")
            else: # Gryffindor is in the lead
                ast "Oh, you expect me to do this now?" ("open", "squint", "base", "mid")
                gen "Of course, why else would I bring it up?" ("base", xpos="far_left", ypos="head")
                ast "But... Gryffindor is leading at the moment." ("angry", "base", "base", "mid")
                gen "And?" ("base", xpos="far_left", ypos="head")
                ast "So... There's no immediate need for me to earn more points." ("grin", "base", "base", "mid")
                gen "Right..." ("base", xpos="far_left", ypos="head")
                hide astoria_main
                with d3

                call tutorial("points")

                $ _event.cancel()
                jump astoria_favor_menu.odd_jobs

        elif states.ast.level >= 13:
            ast "I'm not sure what you--" ("angry", "base", "base", "mid")
            gen "I want you to wear this." ("base", xpos="far_left", ypos="head")
            ast @ cheeks blush "A librarian’s outfit?! This is completely inappropriate!" ("angry", "narrow", "base", "down")
            gen "You need to be properly dressed for the job, don’t you think?" ("base", xpos="far_left", ypos="head")  
            gen "You'll earn points for your efforts." ("base", xpos="far_left", ypos="head")
            ast @ cheeks blush "*Hmm*... Well, I suppose organizing and maintaining the library could use an extra hand." ("open", "closed", "base", "mid")
            gen "That’s the spirit!" ("base", xpos="far_left", ypos="head")
            gen "Just be sure to report back in the evening with any earnings." ("base", xpos="far_left", ypos="head")
            ast @ cheeks blush "Return with what?" ("open", "base", "base", "mid")
            gen "Your earnings." ("base", xpos="far_left", ypos="head")
            gen "This must remain off the record, so I’ll keep them for now." ("base", xpos="far_left", ypos="head")
            ast @ cheeks blush "Oh... Right..." ("open", "closed", "base", "mid")

            if states.ast.level >= 16:
                ast @ cheeks blush "Let me just get changed..." ("angry", "base", "base", "mid")
            elif states.ast.level < 16:
                if not is_in_lead(gryffindor):
                    ast @ cheeks blush "Let me just get changed..." ("angry", "base", "base", "mid")
                else: # Gryffindor in the lead
                    ast "Oh, you expect me to do this now?" ("open", "squint", "base", "mid")
                    gen "Of course, why else would I bring it up?" ("base", xpos="far_left", ypos="head")
                    ast "But... Gryffindor is leading at the moment." ("angry", "base", "base", "mid")
                    gen "And?" ("base", xpos="far_left", ypos="head")
                    ast "So... There's no immediate need for me to earn more points." ("grin", "base", "base", "mid")
                    gen "Right..." ("base", xpos="far_left", ypos="head")
                    hide astoria_main
                    with d3

                    call tutorial("points")

                    $ _event.cancel()
                    jump astoria_favor_menu.odd_jobs
            elif states.ast.level < 22:
                ast "Of course, [name_genie_astoria]..." ("base", "squint", "base", "mid", xpos="right", ypos="base")
            else: # 22+
                ast "As you wish, [name_genie_astoria]." ("base", "base", "base", "mid", xpos="right", ypos="base")


    show screen blkfade
    with d5
    # Setup
    $ her_outfit_library.used = True
    play sound "sounds/cloth_sound.ogg"
    $ her_outfit_last.save()
    $ astoria.equip(ast_outfit_dishwash)
    hide screen blkfade
    with d5

    pause 2.5
    hide astoria_main
    with d3

    gen "Off you go then..." ("base", xpos="far_left", ypos="head")

    call her_walk(action="leave")

    $ states.ast.busy = True
    $ current_job = "library"

    jump main_room_menu

label ast_dishwasher_job_return:

    python:
        progress_factor = math.log(states.ast.tier + states.cho.tier + states.ton.tier + states.lun.tier + game.day)
        payment = int(progress_factor * random_gold)
    
    $ astoria.equip(ast_outfit_dishwash)

    call her_walk(action="enter", xpos="mid", ypos="base")

    gen "[name_astoria_genie]... How was your day working in the library?" ("base", xpos="far_left", ypos="head")
    ast "*Well*, it was as uneventful as it gets..." ("soft", "base", "base", "mid", xpos="right", ypos="base", trans=dissolve)

    menu:
        "\"What exactly did you do today?\"":
            if states.ast.level < 13:
                random:
                    block:
                        ast "It was as normal a day of organizing books and assisting students as it could be." ("open", "base", "base", "mid")
                        ast "Although, considering that I'm supposed to be in class during the day, I guess it's not that normal." ("soft", "base", "base", "R")
                        gen "Don't worry, [name_astoria_genie], you'll get your points." ("base", xpos="far_left", ypos="head")
                        gen "Just think of how happy your friends will be when they win the house cup this year." ("base", xpos="far_left", ypos="head")
                        ast "I suppose..." ("open", "base", "base", "R")
                        gen "Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
                    block:
                        ast "It was fine, I suppose..." ("soft", "base", "base", "R")
                        gen "Nothing else to tell me? What were you tasked to do today?" ("base", xpos="far_left", ypos="head")
                        ast "*Ehm*..." ("open", "narrow", "base", "down")
                        ast "Well, I was asked to reorganize the Potions section..." ("angry", "closed", "base", "mid")
                        gen "Right..." ("base", xpos="far_left", ypos="head")
                        ast "They really should've warned me beforehand... How was I supposed to know Snape left ingredients scattered all over the place?" ("clench", "narrow", "base", "down")
                        gen "Ten points to Gryffindor!" ("base", xpos="far_left", ypos="head")
                        ast "..." ("angry", "base", "base", "mid")
                    block:
                        ast "Professor McGonagall had me review and catalog old books all day..." ("open", "narrow", "base", "mid")
                        gen "Doesn't sound too bad..." ("base", xpos="far_left", ypos="head")
                        ast "She insisted I check every single one for illegal notes or tampered pages..." ("disgust", "narrow", "base", "mid")
                        ast "When I asked why, she simply said it was important to keep the archive in order..." ("angry", "narrow", "base", "mid")
                        ast "As if there was a real system there to begin with... I bet she just wanted to keep certain spells hidden." ("open", "closed", "annoyed", "mid")
                        ast "..." ("upset", "narrow", "base", "mid")
                        ast "Can I have my points now?" ("angry", "narrow", "base", "mid")
                        gen "Of course... Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
            elif states.ast.level < 22:
                random:
                    block:
                        ast "It was pretty uneventful." ("open", "base", "base", "R")
                        ast "I suppose I should feel more annoyed by the otast students staring at me, but it doesn’t botast me that much." ("open", "base", "base", "R")
                        gen "Good to hear." ("base", xpos="far_left", ypos="head")
                        ast "I am helping the school, after all..." ("base", "closed", "base", "mid")
                        gen "That you are... Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
                    block:
                        ast "I had to dust all the library shelves today." ("open", "closed", "base", "mid")
                        gen "That doesn't sound too bad..." ("base", xpos="far_left", ypos="head")
                        ast "Well, I got yelled at by Madam Pince for no reason." ("upset", "squint", "base", "mid")
                        ast "She kept saying that otast students needed to study and that I was distracting them." ("clench", "narrow", "base", "mid")
                        ast "Yet she didn’t tell me to stop cleaning..." ("annoyed", "narrow", "base", "mid")
                        gen "Sounds like a job well done to me... Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
                        ast "..." ("angry", "squint", "base", "mid")
                    block:
                        ast "Pretty uneventful." ("open", "base", "base", "R")
                        ast "I spent most of my time in the restricted section, so there weren’t many people around." ("soft", "base", "base", "mid")
                        ast @ cheeks blush "Although, one of the portraits kept whispering at me..." ("open", "squint", "base", "R")
                        gen "Was it an interesting portrait?" ("base", xpos="far_left", ypos="head")
                        ast @ cheeks blush "..." ("normal", "squint", "base", "mid")
                        ast @ cheeks blush "As interesting as a haunted portrait can be, I suppose..." ("normal", "squint", "base", "mid")
                        gen "Nicely done... Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
            else: #22+
                random:
                    block:
                        ast @ cheeks blush "It was fine... I helped manage the library records today..." ("open", "closed", "base", "mid")
                        ast @ cheeks blush "Madam Pince seemed to find it amusing to have me constantly climbing the ladder to reach books." ("angry", "narrow", "base", "R")
                        gen "Well, I suppose that comes with the job." ("base", xpos="far_left", ypos="head")
                        ast @ cheeks blush "That's what she said..." ("angry", "narrow", "base", "down")
                        gen "Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
                    block:
                        ast "Good, although I didn’t really get much work done today." ("open", "narrow", "base", "R")
                        gen "Oh...{w=0.4} Why's that?" ("base", xpos="far_left", ypos="head")
                        ast "Well...{w=0.4} I was asked to assist the house elves in restoring old books, but every time I started doing something, one of them would do it for me." ("angry", "squint", "base", "mid")
                        ast "Constantly apologizing for not having done it yet and bowing to me..." ("open", "narrow", "base", "mid")
                        gen "(Uh-oh...)" ("base", xpos="far_left", ypos="head")
                        ast @ cheeks blush "It was kind of cute, to be honest." ("base", "squint", "base", "R")
                        gen "Well then, I assume you still got paid?" ("base", xpos="far_left", ypos="head")
                        ast @ cheeks blush "Oh...{w=0.4} Yes, [name_genie_astoria]..." ("angry", "base", "base", "mid")
                        gen "Great! Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
                    block:
                        gen "Tell me what you've been doing." ("base", xpos="far_left", ypos="head")
                        ast @ cheeks blush "I've been organizing Professor Tonks' archives..." ("open", "base", "base", "mid")
                        ast @ cheeks blush "The things she keeps in there..." ("angry", "narrow", "base", "down")
                        ast @ cheeks blush "I really hope no students get detention with her." ("open", "closed", "base", "mid")
                        gen "Found anything interesting?" ("base", xpos="far_left", ypos="head")
                        ast @ cheeks blush "*Hmm*... Not sure if she'd like it if I told you..." ("angry", "narrow", "base", "R")
                        gen "(As if I couldn't already guess...)" ("base", xpos="far_left", ypos="head")
                        gen "Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")

        "-Dismiss her-":
            gen "Great, then that will be all for now." ("base", xpos="far_left", ypos="head")
            gen "Ten points to Gryffindor." ("base", xpos="far_left", ypos="head")
    
    gen "Good job, Hermione. You earned your points." ("base", xpos="far_left", ypos="head")
    ast "Thank you, [name_genie_astoria]." ("open", "base", "base", "mid")
    ast "Here's the payment." ("open", "base", "base", "mid")
    nar "You receive {number=payment} gold coins."

    $ gryffindor+= 10
    $ game.gold += payment

    call her_walk(action="leave")

    $ astoriaermione.equip(ast_outfit_last)

    $ states.ast.busy = True
    $ current_job = None

    jump main_room_menu

#Send Hermione to work, promoting the card game.


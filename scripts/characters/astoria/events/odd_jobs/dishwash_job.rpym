label ast_dishwasher_job:  

    if not states.ast.ev.dishwasher_job.intro_complete:  
        $ states.ast.ev.dishwasher_job.intro_complete = True  

        ast "" ("base", "base", "base", "mid", xpos="right", ypos="base", trans=fade) # Neutral expression, waiting for information.
        gen "I have another job opportunity for you, [name_astoria_genie]." ("base", xpos="far_left", ypos="head") # Neutral expression, presenting an offer.
        ast "What kind of job this time?" ("clench", "narrow", "worried", "down") # Clenched teeth (anticipation/suspicion), narrowed eyes (skepticism), worried eyebrows (apprehension), pupils down (hesitation).
        gen "Tom, the owner of the Leaky Cauldron, needs an extra hand washing dishes." ("base", xpos="far_left", ypos="head") # Neutral expression, delivering the information.
        ast "You want me to scrub dishes in a hot, steamy kitchen?" ("angry", "narrow", "angry", "L") # Anger, narrowed eyes (disbelief), furrowed eyebrows (fury), pupils left (disgust).
        gen "That’s exactly it! A good, honest job. And of course, you'll be rewarded with sentence reduction." ("base", xpos="far_left", ypos="head") # Neutral expression, attempting to be persuasive.

        if states.ast.level < 13:
            ast "..." ("angry", "narrow", "angry", "down") # Anger, narrowed eyes (annoyance), furrowed eyebrows (fury), pupils down (disapproval).
            gen "Yes, I have something for you to wear..." ("base", xpos="far_left", ypos="head") # Neutral expression, presenting something.
            ast @ cheeks blush "A dishwash’s outfit?! This is completely inappropriate!" ("angry", "narrow", "angry", "L") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils left (emphasis).
            gen "You need to be properly dressed for the job, don’t you think?" ("base", xpos="far_left", ypos="head") # Neutral expression, rhetorical question.
            gen "You'll be compensated with sentence reduction, naturally." ("base", xpos="far_left", ypos="head") # Neutral expression, stating the benefit.
            ast "*Hmm*...{w=0.4} Well, if it contributes to knowledge and order, I suppose I can accept." ("angry", "closed", "worried", "R") # Anger, closed eyes (reluctant acceptance), worried eyebrows (hesitation), pupils right (reluctance).
            gen "Good. However, any monetary compensation must be returned to me." ("base", xpos="far_left", ypos="head") # Neutral expression, stating a condition.
            ast "Must I?" ("clench", "narrow", "worried", "up") # Clenched teeth (frustration), narrowed eyes (annoyance), worried eyebrows (displeasure), pupils up (questioning).
            gen "Do you think I can just let students profit from these tasks?" ("base", xpos="far_left", ypos="head") # Neutral expression, rhetorical question with a hint of authority.
            ast "*Ehm*..." ("angry", "narrow", "angry", "ahegao") # Anger, narrowed eyes (frustration), furrowed eyebrows (fury), pupils ahegao (desperation/exasperation).
            gen "No, I believe it’s best if I handle that for now." ("base", xpos="far_left", ypos="head") # Neutral expression, asserting control.
            ast "Very well..." ("open", "narrow", "base", "mid") # Open mouth (resignation), narrowed eyes (annoyance), neutral eyebrows (submission), pupils center (resignation).
            gen "Return in the evening to report how it went and turn in any payments." ("base", xpos="far_left", ypos="head") # Neutral expression, giving instructions.
                
        elif states.ast.level >= 13:
            ast "I suppose it could be worse..." ("base", "narrow", "worried", "down") # Neutral expression, narrowed eyes (hesitation), worried eyebrows (reluctance), pupils down (resignation).
            ast "Alright, I’ll do it!" ("base", "narrow", "base", "L") # Neutral expression, narrowed eyes (reluctant agreement), neutral eyebrows (acceptance), pupils left (hesitation).
            gen "Great! Here’s your uniform." ("base", xpos="far_left", ypos="head") # Neutral expression, presenting the uniform.
            ast @ cheeks blush "..." ("angry", "narrow", "angry", "R") # Anger, narrowed eyes (disgust), furrowed eyebrows (fury), pupils right (disbelief).
            ast "You have got to be kidding me!" ("angry", "closed", "angry", "up") # Anger, closed eyes (indignation), furrowed eyebrows (fury), pupils up (exasperation).
            gen "What’s the problem?" ("base", xpos="far_left", ypos="head") # Neutral expression, questioning.
            ast @ cheeks blush "This apron is so short it barely covers anything!" ("angry", "narrow", "angry", "ahegao") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils ahegao (desperation).
            ast @ cheeks blush "And why does this top have such a deep neckline?! This isn't necessary for washing dishes!" ("angry", "narrow", "angry", "down") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils down (disgust).
            gen "Standard uniform. Rules are rules, [name_genie_astoria]." ("base", xpos="far_left", ypos="head") # Neutral expression, stating the rules.
            ast @ cheeks blush "And this fabric... It's white! If it gets wet, it'll be *completely* see-through!" ("angry", "narrow", "worried", "mid") # Anger, narrowed eyes (worry), worried eyebrows (anxiety), pupils center (concern).
            gen "I suppose you’ll just have to be extra careful, then." ("base", xpos="far_left", ypos="head") # Neutral expression, dismissive.
            ast "*Sigh*... Fine, let's get this over with." ("angry", "closed", "angry", "L") # Anger, closed eyes (resignation), furrowed eyebrows (fury), pupils left (reluctant acceptance).
            gen "However, any monetary compensation must be returned to me." ("base", xpos="far_left", ypos="head") # Neutral expression, stating a condition.
            ast "..." ("angry", "narrow", "angry", "R") # Anger, narrowed eyes (frustration), furrowed eyebrows (fury), pupils right (disgust/frustration).
            gen "Good attitude! Now, get to work and come back when you're done." ("base", xpos="far_left", ypos="head") # Neutral expression, dismissive and slightly mocking.

        elif states.ast.level < 22:
                ast "Of course, [name_genie_astoria]..." ("base", "narrow", "worried", "down") # Neutral expression, narrowed eyes (skepticism), worried eyebrows (reluctance), pupils down (hesitation).
        else: # 22+
                ast "As you wish, [name_genie_astoria]." ("base", "closed", "base", "mid") # Neutral expression, closed eyes (resignation), neutral eyebrows (submission), pupils center (resignation).

    show screen blkfade
    with d5
    # Setup
    $ ast_outfit_dishwash.used = True
    play sound "sounds/cloth_sound.ogg"
    $ ast_outfit_last.save()
    $ astoria.equip(ast_outfit_dishwash)
    # $ astoria.equip(ast_bra_dishwash)
    $ astoria.equip(ast_panties_dishwash)
    hide screen blkfade
    with d5

    pause 2.5
    hide astoria_main
    with d3

    gen "Off you go then..." ("base", xpos="far_left", ypos="head")

    call ast_walk(action="leave")

    $ states.ast.busy = True
    $ current_job = "Dishwash"

    jump main_room_menu

label ast_dishwasher_job_return:

    python:
        progress_factor = math.log(states.ast.tier + states.cho.tier + states.ton.tier + states.lun.tier + game.day)
        payment = int(progress_factor * random_gold)

    $ ast_end_day = ""
    $ is_wet = False
    $ missing_top = False
    $ missing_bra = False
    $ missing_bottom = False
    $ missing_panties = False

    # Select End Day - status and Missing Clouthes
    if states.ast.level < 13:           
        random:
            block:
                # "The See-Through Uniform Dilemma"
                $ ast_end_day = "The See-Through Uniform Dilemma"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = False
            block:
                # "Sweating Like a Lobster in the Kitchen Sauna"
                $ ast_end_day = "Sweating Like a Lobster in the Kitchen Sauna"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = False
            block:
                # "The Soggy Tissue Chronicles"
                $ ast_end_day = "The Soggy Tissue Chronicles"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False
    elif states.ast.level < 22:
        random:
            block:
                $ ast_end_day = "The Boiling Storm: A Kitchen Nightmare"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = False
            block:
                $ ast_end_day = "Miss Drippy: The Kitchen Chronicles"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False 
            block:
                $ ast_end_day = "Miss Misty: The Teapot Incident"
                $ is_wet = True
                $ missing_top = False
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = False 
    else:
        random:
            block:
                $ ast_end_day = "The Cauldron Catastrophe: A Steamy Misadventure"
                $ is_wet = True
                $ missing_top = True
                $ missing_bra = False
                $ missing_bottom = False
                $ missing_panties = False                           
            block:
                $ ast_end_day = "The Floating Fiasco: A Kitchen Shame Spiral"
                $ is_wet = True
                $ missing_top = True
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False
            block:
                $ ast_end_day = "The Zipline Escape: A Sauce-Soaked Disaster"
                $ is_wet = True
                $ missing_top = True
                $ missing_bra = False
                $ missing_bottom = True
                $ missing_panties = False


    
    if is_wet:
        $ ast_outfit_dishwash.group[2].color[0] ="#DDDDDDDD" 
        $ ast_outfit_dishwash.group[0].color[0] ="#DDDDDDDD" 

    $ astoria.equip(ast_outfit_dishwash)
    $ ast_outfit_dishwash.group[2].color[0] ="#ffffffff" 
    $ ast_outfit_dishwash.group[0].color[0] ="#ffffffee" 
    if missing_top:
        $ astoria.strip("top")
    if missing_bra:
        $ astoria.strip("bra")

    if missing_bottom:
        $ astoria.strip("bottom")
    if missing_panties:
        $ astoria.strip("panties")
    else:
        $ astoria.equip(ast_panties_dishwash)
    call ast_walk(action="enter", xpos="mid", ypos="base")
    # (mouth="open", eyes="base", eyebrows="angry", pupils="mid")
    gen "[name_astoria_genie]... How was your day working in the Leaky Cauldron?" ("base", xpos="far_left", ypos="head")
    ast "*Well*, it was as uneventful as it gets..." ("clench", "base", "angry", "mid", xpos="base", ypos="base", trans=d3)

    menu:
        "\"What exactly did you do today?\"":
            if ast_end_day== "The See-Through Uniform Dilemma":
                ast "This uniform is *completely* impractical!" ("clench", "narrow", "angry", "down") # Clenched teeth (frustration), narrowed eyes (irritation), furrowed eyebrows (anger), pupils down (disapproval).
                gen "What happened this time?" ("base", xpos="far_left", ypos="head") # Neutral expression, curiosity.
                ast "Every time I washed a dish, water splashed all over me!" ("annoyed", "narrow", "base", "L") # Annoyance, narrowed eyes (discontent), neutral eyebrows (frustration), pupils left (disdain).
                ast "And do you know what happens when a *white* uniform gets wet?" ("annoyed", "narrow", "worried", "mid") # Annoyance, narrowed eyes (worry), worried eyebrows (tension), pupils center (expectation).
                gen "Hmm... I imagine it becomes more breathable?" ("grin", xpos="far_left", ypos="head") # Ironic grin, teasing.
                ast @ cheeks blush "*See-through!* It becomes *see-through!*" ("angry", "narrow", "angry", "R") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils right (accusation).
                gen "Oh dear. That sounds... revealing." ("base", xpos="far_left", ypos="head") # Neutral expression, slight surprise.
                ast "I had to stand by the stove just to dry off as quickly as possible!" ("annoyed", "narrow", "worried", "up") # Annoyance, narrowed eyes (discomfort), worried eyebrows (anxiety), pupils up (frustration).
                gen "Well, at least you stayed warm. Silver linings, right?" ("grin", xpos="far_left", ypos="head") # Ironic grin, attempt to soften the situation.
                ast "You're impossible! Just give me my sentence reduction!" ("annoyed", "narrow", "angry", "ahegao") # Annoyance, narrowed eyes (frustration), furrowed eyebrows (anger), ahegao pupils (desperation).
                gen "Alright, alright. I’ll consider it—but only if you promise not to flood the kitchen next time." ("base", xpos="far_left", ypos="head") # Neutral expression, conciliatory tone.
                ast "Fine! But if I have to wear this uniform again, I’m bringing a raincoat!" ("annoyed", "narrow", "base", "down") # Annoyance, narrowed eyes (disapproval), neutral eyebrows (resignation), pupils down (disdain).
                gen "Deal. Now go dry off before someone mistakes you for a ghost." ("grin", xpos="far_left", ypos="head") # Ironic grin, sarcastic humor.
            elif ast_end_day== "Sweating Like a Lobster in the Kitchen Sauna":
                ast "The kitchen is like a sauna! I was sweating the entire time!" ("clench", "narrow", "angry", "down") # Clenched teeth (frustration), narrowed eyes (discomfort), furrowed eyebrows (anger), pupils down (disgust).
                gen "That’s to be expected. It’s a kitchen." ("base", xpos="far_left", ypos="head") # Neutral expression, factual statement.
                ast "Expected?! Do you know what it’s like to feel like a lobster in a boiling pot?!" ("angry", "narrow", "angry", "L") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils left (accusation).
                gen "Well, at least you’re already red. Saves time on the cooking process." ("grin", xpos="far_left", ypos="head") # Grin, sarcastic humor.
                ast "Ugh! And this uniform is *awful*! The apron barely covers anything, and the top kept sliding down!" ("angry", "narrow", "worried", "R") # Anger, narrowed eyes (frustration), worried eyebrows (annoyance), pupils right (disgust).
                gen "Sounds like a fashion statement. ‘Wet and Wild: Kitchen Edition.’" ("grin", xpos="far_left", ypos="head") # Grin, teasing.
                ast @ cheeks blush "Oh, sure, because I spent half my time *holding up my shirt*!" ("angry", "narrow", "angry", "up") # Anger, narrowed eyes (embarrassment), furrowed eyebrows (fury), pupils up (exasperation).
                ast "Do you know what happens when a *white* uniform gets wet? It becomes *see-through*! Like, *completely* transparent!" ("angry", "narrow", "angry", "ahegao") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils ahegao (desperation).
                gen "Ah, the classic ‘wet T-shirt contest’ look. Very trendy." ("grin", xpos="far_left", ypos="head") # Grin, ironic humor.
                ast @ cheeks blush "This isn’t funny! I looked like a soggy tissue clinging to a window!" ("angry", "narrow", "angry", "mid") # Anger, narrowed eyes (embarrassment), furrowed eyebrows (fury), pupils center (fury).
                gen "A soggy tissue? That’s a new one. I’ll add it to the list of Astoria’s kitchen adventures." ("grin", xpos="far_left", ypos="head") # Grin, teasing.
                ast "Can I have my sentence reduction now and *never* do this again?" ("angry", "closed", "worried", "down") # Anger, closed eyes (desperation), worried eyebrows (anxiety), pupils down (pleading).
                gen "Great! Your sentence reduction is updated." ("grin", xpos="far_left", ypos="head") # Grin, cheerful tone.
                ast "Finally! But if I have to wear this uniform again, I’m bringing a raincoat and a *parachute*!" ("angry", "narrow", "angry", "L") # Anger, narrowed eyes (determination), furrowed eyebrows (fury), pupils left (resolve).
                gen "A parachute? For the kitchen? Now that’s a fashion statement I’d pay to see." ("grin", xpos="far_left", ypos="head") # Grin, amused sarcasm.
            elif ast_end_day== "The Soggy Tissue Chronicles":
                ast "Do you know how *little* coverage these sleeves offer?!" ("clench", "narrow", "angry", "down") # Clenched teeth (frustration), narrowed eyes (annoyance), furrowed eyebrows (anger), pupils down (disgust).
                gen "I assume... not much?" ("base", xpos="far_left", ypos="head") # Neutral expression, questioning tone.
                ast "Exactly! Every time I reached for a high shelf, the sleeves rolled up and my arms got splattered with hot water!" ("angry", "narrow", "worried", "L") # Anger, narrowed eyes (frustration), worried eyebrows (annoyance), pupils left (disgust).
                ast "And then, I had to clean my arms, which meant *more* water, which meant getting *even wetter*!" ("angry", "narrow", "worried", "mid") # Anger, narrowed eyes (frustration), worried eyebrows (annoyance), pupils center (emphasis).
                gen "Sounds like quite the cycle." ("base", xpos="far_left", ypos="head") # Neutral expression, slightly amused.
                ast "Oh, and let’s not forget that the heat made my hair stick to my face the entire time!" ("angry", "narrow", "worried", "R") # Anger, narrowed eyes (discomfort), worried eyebrows (annoyance), pupils right (disgust).
                gen "A hard day's work builds character, [name_astoria_genie]." ("base", xpos="far_left", ypos="head") # Neutral expression, attempting to be motivational.
                ast @ cheeks blush "I’d rather build character *without* this ridiculous uniform." ("angry", "narrow", "worried", "up") # Anger, narrowed eyes (annoyance), worried eyebrows (frustration), pupils up (exasperation).
                ast "But wait, it gets worse! When I was reaching for a pot, my skirt got caught on a hook!" ("angry", "narrow", "angry", "ahegao") # Anger, narrowed eyes (shock), furrowed eyebrows (fury), pupils ahegao (desperation).
                gen "A hook? In the kitchen? How... industrial." ("grin", xpos="far_left", ypos="head") # Grin, sarcastic humor.
                ast "Industrial?! The fabric of this skirt is so cheap, it tore like *paper*!" ("angry", "narrow", "angry", "down") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils down (disgust).
                ast @ cheeks blush "And then, with all the steam, my... my *undergarments* started getting wet too!" ("grin","base","angry","ahegao") # Soft expression, narrowed eyes (embarrassment), neutral eyebrows (shame), pupils downR (shame).
                gen "Ah, the classic ‘steamy kitchen surprise.’ Very... revealing." ("grin", xpos="far_left", ypos="head") # Grin, teasing.
                ast "Revealing?! I looked like a walking *wet tissue*! A soggy, transparent mess!" ("angry", "narrow", "angry", "L") # Anger, narrowed eyes (indignation), furrowed eyebrows (fury), pupils left (disgust).
                gen "Well, at least you’re consistent. Wet on top, wet on bottom—truly a masterpiece of kitchen fashion." ("grin", xpos="far_left", ypos="head") # Grin, sarcastic humor.
                ast "*Ugh!* Just give me my sentence reduction!" ("clench", "narrow", "angry", "R") # Clenched teeth (frustration), narrowed eyes (annoyance), furrowed eyebrows (anger), pupils right (demand).
